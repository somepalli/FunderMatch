FUNDERMATCH_DATABASE_URL=postgresql://fundermatch:fundermatch-local-only@localhost:7444/fundermatch
FUNDERMATCH_JWT_SECRET=replace-with-at-least-32-random-characters
FUNDERMATCH_JWT_ISSUER=fundermatch
FUNDERMATCH_JWT_AUDIENCE=fundermatch-api
FUNDERMATCH_QDRANT_URL=http://127.0.0.1:6999
FUNDERMATCH_QDRANT_COLLECTION=fundermatch_precedents
FUNDERMATCH_BGE_SNAPSHOT_DIR=C:\path\to\pinned\bge-m3-snapshot
FUNDERMATCH_INTAKE_DIR=C:\Users\your-name\Documents\FunderMatch_Data\borrower_intake
FUNDERMATCH_POLICY_PATH=configs/funder_policies.yaml
FINDOCIQ_BASE_URL=http://127.0.0.1:8989
FINDOCIQ_INGEST_TOKEN=replace-with-a-separate-random-ingestion-token
LANGGRAPH_STRICT_MSGPACK=true
FUNDERMATCH_AGENT_ORCHESTRATION_ENABLED=false
FUNDERMATCH_LANGFUSE_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel/v1/traces
FUNDERMATCH_LANGFUSE_HEALTH_URL=http://host.docker.internal:3000/api/public/health
FUNDERMATCH_VLLM_HEALTH_URL=http://host.docker.internal:8900/v1/models
FUNDERMATCH_MAINTENANCE_INTERVAL_SECONDS=3600
LANGFUSE_PUBLIC_KEY=replace-with-existing-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-existing-langfuse-secret-key
